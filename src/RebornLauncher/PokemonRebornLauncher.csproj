<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PokemonRebornLauncher</RootNamespace>
    <AssemblyName>launcher</AssemblyName>
    <Product>Pokemon Reborn Launcher</Product>
    <Authors>Elias</Authors>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets/reborn.ico</ApplicationIcon>
    <Version>7.0.0</Version>
    <AssemblyVersion>7.0.0.0</AssemblyVersion>
    <FileVersion>7.0.0.0</FileVersion>
    <Description>Reborn Launcher mit automatischer Selbstaktualisierung</Description>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <None Update="settings.json" CopyToOutputDirectory="Never" />
    <Resource Include="assets/reborn.ico" />
    <None Include="background.png" Condition="Exists('background.png')" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="logo.png" Condition="Exists('logo.png')" LogicalName="PokemonRebornLauncher.logo.png" />
    <None Include="icon.ico" Condition="Exists('icon.ico')" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
