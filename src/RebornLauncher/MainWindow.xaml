<Window x:Class="PokemonRebornLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:PokemonRebornLauncher.UI"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Pokémon Reborn – Launcher"
        Icon="pack://application:,,,/assets/reborn.ico"
        Width="1560" Height="940" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        ResizeMode="CanResize" Cursor="{DynamicResource ThemeCursor}" Background="#0B090F"
        Loaded="Window_Loaded" KeyDown="Window_KeyDown" Closing="Window_Closing">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="64" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <DrawingBrush x:Key="SceneryEdgeFade" Viewbox="0,0,1,1" ViewboxUnits="Absolute" Stretch="Fill">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <DrawingGroup.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="Transparent" Offset="0"/><GradientStop Color="Black" Offset="0.09"/>
                            <GradientStop Color="Black" Offset="0.88"/><GradientStop Color="Transparent" Offset="1"/>
                        </LinearGradientBrush>
                    </DrawingGroup.OpacityMask>
                    <GeometryDrawing Geometry="M0,0 L1,0 1,1 0,1 Z">
                        <GeometryDrawing.Brush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="Black" Offset="0"/><GradientStop Color="Black" Offset="0.82"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </GeometryDrawing.Brush>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <sys:Boolean x:Key="ReduceMotion">False</sys:Boolean>
        <sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarWidthKey}">6</sys:Double>
        <SolidColorBrush x:Key="Ink" Color="#0B090F" />
        <SolidColorBrush x:Key="Surface" Color="#131018" />
        <SolidColorBrush x:Key="Text" Color="#F4F0F0" />
        <SolidColorBrush x:Key="Muted" Color="#B4AEBB" />
        <SolidColorBrush x:Key="Faint" Color="#817986" />
        <SolidColorBrush x:Key="Violet" Color="#B16AE6" />
        <SolidColorBrush x:Key="Mint" Color="#9BE6D2" />
        <SolidColorBrush x:Key="CtaText" Color="#100B15"/>
        <SolidColorBrush x:Key="Line" Color="#39313F" />
        <Style x:Key="Eyebrow" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="pack://application:,,,/assets/fonts/#Barlow" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        </Style>
        <Style x:Key="BodyText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="pack://application:,,,/assets/fonts/#Barlow" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="ui:ReactiveFeedback.Enabled" Value="True"/><Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Cursor" Value="{DynamicResource ThemeCursor}" />
            <Setter Property="FontFamily" Value="pack://application:,,,/assets/fonts/#Barlow" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <Border.RenderTransform><TranslateTransform x:Name="ButtonLift" Y="0" /></Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{DynamicResource Mint}"/><Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource Line}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.72"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.4"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{DynamicResource Mint}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Foreground" Value="#FFB8C0" />
            <Setter Property="BorderBrush" Value="#854357" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="ui:ReactiveFeedback.Enabled" Value="True"/><Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Foreground" Value="{DynamicResource CtaText}" />
            <Setter Property="Background" Value="{DynamicResource Violet}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Mint}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="24,0" />
            <Setter Property="Height" Value="66" />
            <Setter Property="MinWidth" Value="228" />
            <Setter Property="Cursor" Value="{DynamicResource ThemeCursor}" />
            <Setter Property="FontFamily" Value="pack://application:,,,/assets/fonts/#Barlow Condensed" />
            <Setter Property="FontSize" Value="23" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CtaSurface" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <Border.RenderTransform><TranslateTransform x:Name="CtaLift" Y="0" /></Border.RenderTransform>
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CtaSurface" Property="Background" Value="{DynamicResource Mint}"/><Setter TargetName="CtaSurface" Property="BorderBrush" Value="{DynamicResource Violet}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="CtaSurface" Property="Opacity" Value="0.78"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="CtaSurface" Property="Opacity" Value="0.4"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CtaSurface" Property="BorderBrush" Value="{DynamicResource Mint}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavigationButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="0,0,0,2"/><Setter Property="Padding" Value="10,0"/><Setter Property="MinHeight" Value="44"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="NavSurface" Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavSurface" Property="BorderBrush" Value="{DynamicResource Mint}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="NavSurface" Property="Opacity" Value="0.72"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="NavSurface" Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="NavSurface" Property="BorderBrush" Value="{DynamicResource Mint}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="WindowControlButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <!-- The title bar touches the window edge; a hover lift would move
                 its buttons outside the window. Keep color feedback in place. -->
            <Setter Property="ui:ReactiveFeedback.Enabled" Value="False"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="MinWidth" Value="42"/><Setter Property="MinHeight" Value="32"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        </Style>
        <Style x:Key="VersionSegment" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0,0,0,2"/><Setter Property="BorderBrush" Value="#39313F"/><Setter Property="Padding" Value="0,8"/><Setter Property="MinHeight" Value="34"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="{DynamicResource Mint}"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="ToggleCheckBox" TargetType="CheckBox">
            <Setter Property="ui:ReactiveFeedback.Enabled" Value="True"/><Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="FontFamily" Value="pack://application:,,,/assets/fonts/#Barlow"/><Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="{DynamicResource ThemeCursor}"/><Setter Property="Focusable" Value="True"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid MinHeight="30"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/><Border x:Name="SwitchTrack" Grid.Column="1" Width="36" Height="20" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" HorizontalAlignment="Right" VerticalAlignment="Center"><Ellipse x:Name="SwitchThumb" Width="12" Height="12" Fill="#B9AFBF" HorizontalAlignment="Left" Margin="3,0,0,0"><Ellipse.RenderTransform><TranslateTransform x:Name="SwitchPosition" X="0" /></Ellipse.RenderTransform></Ellipse></Border><Border x:Name="FocusMark" Grid.ColumnSpan="2" BorderBrush="Transparent" BorderThickness="1" CornerRadius="1" IsHitTestVisible="False"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="SwitchTrack" Property="Background" Value="{DynamicResource Surface}"/><Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{DynamicResource Violet}"/><Setter TargetName="SwitchThumb" Property="Fill" Value="{DynamicResource Mint}"/><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="SwitchPosition" Storyboard.TargetProperty="X" To="16" Duration="0:0:0.16"/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="SwitchPosition" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16"/></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusMark" Property="BorderBrush" Value="{DynamicResource Mint}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ModernProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="5"/><Setter Property="Background" Value="#302738"/><Setter Property="Foreground" Value="{DynamicResource Mint}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar"><Grid ClipToBounds="True"><Border Background="{TemplateBinding Background}"/><Border x:Name="PART_Track"/><Decorator x:Name="PART_Indicator" HorizontalAlignment="Left"><Border Background="{TemplateBinding Foreground}"/></Decorator></Grid></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="5"/><Setter Property="Opacity" Value="0.5"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
                <Grid Background="Transparent"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
                    <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False" Opacity="0"/></Track.DecreaseRepeatButton>
                    <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#42314F" CornerRadius="3" Margin="1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                    <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False" Opacity="0"/></Track.IncreaseRepeatButton>
                </Track></Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="Slider">
          <Setter Property="ui:ReactiveFeedback.Enabled" Value="True"/><Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
          <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Border x:Name="SliderFocus" BorderThickness="1" BorderBrush="Transparent" Padding="3">
            <Grid><Border Background="#4A3C55" Height="3" VerticalAlignment="Center" CornerRadius="2"/>
              <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}">
                <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False" Opacity="0"/></Track.DecreaseRepeatButton>
                <Track.Thumb><Thumb Width="12" Height="12"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="{DynamicResource Mint}"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False" Opacity="0"/></Track.IncreaseRepeatButton>
              </Track></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SliderFocus" Property="BorderBrush" Value="{DynamicResource Mint}"/></Trigger></ControlTemplate.Triggers>
          </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Background="{DynamicResource Ink}" ClipToBounds="True">
        <ui:AtmosphericBackdrop x:Name="AtmosphereView" IsHitTestVisible="False"/>
        <Border x:Name="AccentGlow" Width="520" Height="310" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="220,105,0,0" Opacity="0.11" IsHitTestVisible="False">
            <Border.Background><RadialGradientBrush><GradientStop Color="#A95BCD" Offset="0"/><GradientStop Color="#585BCD" Offset="0.48"/><GradientStop Color="#00585BCD" Offset="1"/></RadialGradientBrush></Border.Background>
        </Border>
        <Grid x:Name="NearSceneLayer" IsHitTestVisible="False" ClipToBounds="True"/>

        <Grid x:Name="MainShell">
            <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="{DynamicResource Ink}">
                <Grid Width="640" HorizontalAlignment="Center" Margin="0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button x:Name="HomeNavButton" Grid.Column="0" Content="⌂   Startseite" Tag="home" Style="{StaticResource NavigationButton}" Click="HomeNav_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button x:Name="OpenPatchNotesButton" Grid.Column="1" Content="▤   Changelog" Tag="changelog" Style="{StaticResource NavigationButton}" Click="OpenPatchNotes_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button x:Name="ExtrasNavButton" Grid.Column="2" Content="▰   Extras" Tag="extras" Style="{StaticResource NavigationButton}" Click="ExtrasNav_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button x:Name="SettingsNavButton" Grid.Column="3" Content="⚙   Einstellungen" Tag="settings" Style="{StaticResource NavigationButton}" Click="SettingsNav_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="8,8,12,0">
                    <Button Content="—" ToolTip="Minimieren" Style="{StaticResource WindowControlButton}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="MinimizeButton_Click"/>
                    <Button x:Name="FullscreenButton" Content="□" ToolTip="Fenster maximieren oder wiederherstellen" Width="42" Style="{StaticResource WindowControlButton}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="FullscreenButton_Click"/>
                    <Button Content="×" ToolTip="Schließen" Style="{StaticResource WindowControlButton}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="CloseWindowButton_Click"/>
                </StackPanel>
            </Grid>

            <Grid x:Name="ViewHost" Grid.Row="1" ClipToBounds="True">
                <!-- The scene persists behind every page; only the home UI changes. -->
                        <!-- Props hit-test only their own shapes. Keep them in front
                             of the full-window ScrollViewer input surface. -->
                        <Grid x:Name="PokemonStage" Panel.ZIndex="1">
                            <Grid x:Name="StageArtArea" ClipToBounds="True">
                                <ui:SeasonalScene x:Name="SeasonalBackdrop" ParticlesOnly="True" IsHitTestVisible="False" OpacityMask="{StaticResource SceneryEdgeFade}"/>
                                <Grid Visibility="Collapsed"><ui:SeasonalScene x:Name="LeftEdgeScene" IsHitTestVisible="False"/><ui:SeasonalScene x:Name="RightEdgeScene" IsHitTestVisible="False"/></Grid>
                                <Image x:Name="LeftPokemonTop" Visibility="Collapsed"><Image.RenderTransform><TranslateTransform x:Name="LeftTopFloat"/></Image.RenderTransform></Image>
                                <Image x:Name="RightPokemonBottom" Visibility="Collapsed"><Image.RenderTransform><TranslateTransform x:Name="RightBottomFloat"/></Image.RenderTransform></Image>
                                <ui:PokemonScenery x:Name="PokemonSceneryForeground" ContactShadowsOnly="True" IsHitTestVisible="False" OpacityMask="{StaticResource SceneryEdgeFade}"/>
                                <ui:EventPropsScene x:Name="EventPropsView" Cursor="{DynamicResource ThemeCursor}"/>
                                <Image x:Name="LeftPokemonBottom" IsHitTestVisible="False" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"><Image.RenderTransform><TranslateTransform x:Name="LeftBottomFloat"/></Image.RenderTransform></Image>
                                <Image x:Name="PokemonArtwork" Visibility="Collapsed" IsHitTestVisible="False" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"><Image.RenderTransform><TranslateTransform x:Name="ArtworkFloat"/></Image.RenderTransform></Image>
                                <Image x:Name="RightPokemonTop" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed" IsHitTestVisible="False"><Image.RenderTransform><TranslateTransform x:Name="RightTopFloat"/></Image.RenderTransform></Image>
                                <ui:PokemonScenery x:Name="LeftPokemonOcclusion" Visibility="Collapsed" IsHitTestVisible="False"/>
                                <ui:PokemonScenery x:Name="RightPokemonOcclusion" Visibility="Collapsed" IsHitTestVisible="False"/>
                            </Grid>
                        </Grid>
            <ScrollViewer x:Name="HeroScroller" Grid.Row="1" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" Padding="0">
                <Grid x:Name="ContentLayout" HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions><RowDefinition x:Name="HeroRow" Height="*"/><RowDefinition x:Name="OperationsRow" Height="0"/></Grid.RowDefinitions>
                    <Grid x:Name="HeroContent" Grid.Row="0">
                        <StackPanel x:Name="HeroPanel" Panel.ZIndex="2" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="500" Margin="12,0">
                            <StackPanel.RenderTransform><TranslateTransform x:Name="HeroTranslate"/></StackPanel.RenderTransform>
                            <TextBlock x:Name="SeasonTitleText" TextAlignment="Center" HorizontalAlignment="Center" Text="ZURÜCK IN REBORN" Style="{StaticResource Eyebrow}" Foreground="{DynamicResource Mint}" TextWrapping="Wrap" FontSize="15"/>
                            <Grid x:Name="LogoFrame" Height="220" Width="360" Margin="0,10,0,0" HorizontalAlignment="Center" Background="Transparent" MouseLeftButtonUp="LogoBlood_Click">
                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly"><StackPanel x:Name="LogoFallback"><TextBlock Text="POKÉMON" Foreground="{DynamicResource Text}" FontFamily="pack://application:,,,/assets/fonts/#Barlow Condensed" FontSize="77" FontWeight="Black"/><TextBlock Text="REBORN" Foreground="{DynamicResource Violet}" FontFamily="pack://application:,,,/assets/fonts/#Barlow Condensed" FontSize="89" FontWeight="Black" Margin="0,-34,0,0"/></StackPanel></Viewbox>
                                <Image x:Name="LogoArtwork" Stretch="Uniform" Visibility="Collapsed"/>
                            </Grid>
                            <Border Background="#D90B1020" CornerRadius="8" Padding="12,6" HorizontalAlignment="Center"><StackPanel><TextBlock x:Name="SeasonSubtitleText" TextAlignment="Center" HorizontalAlignment="Center" Text="Deine Geschichte geht weiter." Style="{StaticResource BodyText}" FontSize="16" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            <TextBlock x:Name="PokemonNameText" TextAlignment="Center" HorizontalAlignment="Center" FontFamily="pack://application:,,,/assets/fonts/#Barlow" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" Margin="0,3,0,0"/>
                            </StackPanel></Border><TextBlock x:Name="StageCaptionText" Visibility="Collapsed" Text="DEIN NÄCHSTES ABENTEUER WARTET" Style="{StaticResource Eyebrow}" Foreground="{DynamicResource Violet}" FontSize="10"/>
                            <Button x:Name="StartGameButton" Content="▶   REBORN STARTEN" Style="{StaticResource PrimaryButton}" Width="450" MaxWidth="480" Height="70" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,18,0,0" Click="StartGameButton_Click"/>
                            <Border x:Name="OperationsSurface" Width="500" Background="#E00B1020" CornerRadius="10" Padding="14" Margin="0,12,0,0"><Grid x:Name="OperationsPanel" Width="472" HorizontalAlignment="Center">
                                <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="22"/><RowDefinition Height="26"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="SPIELVERSION" Style="{StaticResource Eyebrow}" FontSize="9"/><TextBlock x:Name="LocalVersionText" Text="–" Foreground="{DynamicResource Text}" FontFamily="pack://application:,,,/assets/fonts/#Barlow Condensed" FontSize="20" FontWeight="Bold"/></StackPanel>
                                    <StackPanel Grid.Column="1" Margin="18,0,0,0"><TextBlock Text="LETZTER PATCH" Style="{StaticResource Eyebrow}" FontSize="9"/><TextBlock x:Name="RemoteVersionText" Text="Prüfe …" Foreground="{DynamicResource Mint}" FontFamily="pack://application:,,,/assets/fonts/#Barlow Condensed" FontSize="20" FontWeight="Bold"/></StackPanel>
                                    <Border x:Name="UpdateBadgeBorder" Grid.Column="2" Background="Transparent" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="8,4" Margin="12,0,0,5" VerticalAlignment="Center"><TextBlock x:Name="UpdateBadgeText" Text="Status wird geprüft" Foreground="{DynamicResource Text}" FontFamily="pack://application:,,,/assets/fonts/#Barlow" FontSize="11" TextWrapping="Wrap"/></Border>
                                </Grid>
                                <StackPanel x:Name="HomeVersionSummary" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="Version:" Foreground="{DynamicResource Faint}" Style="{StaticResource BodyText}" FontSize="11" Margin="0,0,7,0"/>
                                    <TextBlock Text="{Binding Content, ElementName=LatestVersionButton}" Foreground="{DynamicResource Muted}" Style="{StaticResource BodyText}" FontSize="11" MaxWidth="180" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="  ·  " Foreground="{DynamicResource Faint}" Style="{StaticResource BodyText}" FontSize="11"/>
                                    <TextBlock Text="{Binding Content, ElementName=PreviousVersionButton}" Foreground="{DynamicResource Muted}" Style="{StaticResource BodyText}" FontSize="11" MaxWidth="180" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="Der Launcher ist bereit." Style="{StaticResource BodyText}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" VerticalAlignment="Center"/><Button x:Name="CancelButton" Grid.Column="1" Margin="10,0,0,0" Content="Abbrechen" Style="{StaticResource DangerButton}" Visibility="Collapsed" Padding="8,3" FontSize="11" HorizontalAlignment="Right" Click="CancelButton_Click"/></Grid>
                                <StackPanel x:Name="ProgressPanel" Grid.Row="3" Visibility="Collapsed" Margin="0,4,0,0"><ProgressBar x:Name="DownloadProgressBar" Style="{StaticResource ModernProgressBar}" Minimum="0" Maximum="100"/><Grid Margin="0,3,0,0"><TextBlock x:Name="ProgressText" Style="{StaticResource BodyText}" FontSize="11"/><TextBlock x:Name="SpeedText" Foreground="{DynamicResource Mint}" FontFamily="pack://application:,,,/assets/fonts/#Barlow" FontSize="11" HorizontalAlignment="Right"/></Grid></StackPanel>
                            </Grid></Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </ScrollViewer>
            </Grid>


            <Border x:Name="NavigationPanel" Grid.Row="1" Visibility="Collapsed" Margin="28,18" MaxWidth="1040" HorizontalAlignment="Stretch" Background="#F012192A" BorderBrush="#5A7B91B2" BorderThickness="1" CornerRadius="18" IsHitTestVisible="True">
                <Border.Resources>
                    <SolidColorBrush x:Key="Surface" Color="#202D43"/>
                    <SolidColorBrush x:Key="Line" Color="#435878"/>
                </Border.Resources>
                <Border.Effect><DropShadowEffect Color="#080C16" BlurRadius="32" ShadowDepth="8" Opacity="0.48"/></Border.Effect>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Padding="26,17,24,15" Background="#7A182238" CornerRadius="18,18,0,0" BorderBrush="#303D526D" BorderThickness="0,0,0,1">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="REBORN LAUNCHER" Foreground="{DynamicResource Mint}" FontFamily="pack://application:,,,/assets/fonts/#Barlow" FontSize="10" FontWeight="Bold"/>
                                <TextBlock x:Name="NavigationTitle" Text="Changelog" Margin="0,2,0,0" Foreground="{DynamicResource Text}" FontFamily="pack://application:,,,/assets/fonts/#Barlow Condensed" FontSize="30" FontWeight="Bold"/>
                                <TextBlock x:Name="NavigationSubtitle" Text="Neuigkeiten und Änderungen" Margin="0,1,0,0" Foreground="{DynamicResource Muted}" FontFamily="pack://application:,,,/assets/fonts/#Barlow" FontSize="13"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="⌂   Startseite" ToolTip="Zurück zur Startseite" Style="{StaticResource SecondaryButton}" Padding="14,8" VerticalAlignment="Center" Click="HomeNav_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" Margin="24,14,24,14">
        <Border x:Name="ExtrasHost" Visibility="Collapsed" Background="Transparent" Padding="10,4">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ExtrasPanel" MaxWidth="680" HorizontalAlignment="Stretch">
                <TextBlock Text="VERSIONEN UND SPIELDATEIEN" Style="{StaticResource Eyebrow}" Margin="0,0,0,14"/>
                <TextBlock Text="SPIELVERSION AUSWÄHLEN" Style="{StaticResource Eyebrow}" Margin="0,0,0,7"/>
                <Grid ToolTip="{Binding Text, ElementName=VersionSelectionHint}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button x:Name="LatestVersionButton" Content="Aktuell" Style="{StaticResource VersionSegment}" Click="VersionButton_Click"/>
                    <Button x:Name="PreviousVersionButton" Grid.Column="1" Content="Vorherige" Style="{StaticResource VersionSegment}" Click="VersionButton_Click"/>
                </Grid>
                <TextBlock x:Name="VersionSelectionHint" Text="Versionen bleiben verfügbar." Style="{StaticResource BodyText}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,20"/>
                <TextBlock Text="SPIELDATEIEN" Style="{StaticResource Eyebrow}" Margin="0,0,0,7"/>
                <WrapPanel>
                    <Button x:Name="CheckUpdatesButton" Width="150" Content="Updates suchen" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Click="CheckUpdatesButton_Click"/>
                    <Button x:Name="RepairButton" Width="130" Content="Reparieren" ToolTip="Spieldateien reparieren" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Click="RepairButton_Click"/>
                    <Button x:Name="ChooseFolderButton" Width="150" Content="Spielordner …" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Click="ChooseFolderButton_Click"/>
                    <Button x:Name="OpenGameFolderButton" Width="150" Content="Ordner öffnen" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Click="OpenFolderButton_Click"/>
                </WrapPanel>
            </StackPanel>
            </ScrollViewer>
        </Border>

        <Border x:Name="SettingsHost" Visibility="Collapsed" Background="Transparent" Padding="10,4">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="SettingsPanel" MaxWidth="720" HorizontalAlignment="Stretch">
                    <TextBlock Text="ALLGEMEIN" Style="{StaticResource Eyebrow}" Margin="0,0,0,10"/>
                    <CheckBox x:Name="AutoUpdateCheckBox" Content="Vor dem Start automatisch aktualisieren" Style="{StaticResource ToggleCheckBox}" Checked="AutoUpdateCheckBox_Changed" Unchecked="AutoUpdateCheckBox_Changed"/>
                    <CheckBox x:Name="CloseAfterStartCheckBox" Content="Launcher nach Spielstart schließen" Style="{StaticResource ToggleCheckBox}" Checked="CloseAfterStartCheckBox_Changed" Unchecked="CloseAfterStartCheckBox_Changed"/>
                    <Border Height="1" Background="#354B5E79" Margin="0,12,0,12"/>
                    <TextBlock Text="DARSTELLUNG UND BEDIENUNG" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/>
                    <CheckBox x:Name="ReduceMotionCheckBox" Content="Ruhig · Animationen reduzieren" ToolTip="Animationen, Parallax und Effekte reduzieren" Style="{StaticResource ToggleCheckBox}" Checked="ReduceMotion_Changed" Unchecked="ReduceMotion_Changed"/>
                    <CheckBox x:Name="MouseTrailCheckBox" Content="Mausspur" ToolTip="Leuchtspur hinter dem Mauszeiger" Style="{StaticResource ToggleCheckBox}" Checked="MouseTrail_Changed" Unchecked="MouseTrail_Changed"/>
                    <Border Height="1" Background="#354B5E79" Margin="0,12,0,12"/>
                    <TextBlock Text="MUSIK" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/>
                    <CheckBox x:Name="MusicCheckBox" Content="Hintergrundmusik" ToolTip="Hintergrundmusik an oder aus" Style="{StaticResource ToggleCheckBox}" Checked="MusicToggle_Changed" Unchecked="MusicToggle_Changed"/>
                    <Grid Margin="0,3,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><TextBlock Text="Musiklautstärke" Style="{StaticResource BodyText}" VerticalAlignment="Center"/><Slider x:Name="MusicVolumeSlider" Grid.Column="1" ToolTip="Musiklautstärke" Minimum="0" Maximum="1" Value="0.22" SmallChange="0.02" LargeChange="0.1" IsMoveToPointEnabled="True" Focusable="True" ValueChanged="MusicVolume_Changed"/></Grid>
                    <TextBlock x:Name="MusicStatusText" Visibility="Collapsed" Text="AN" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Foreground="{DynamicResource Mint}" FontFamily="pack://application:,,,/assets/fonts/#Barlow" FontSize="10" IsHitTestVisible="False"/>
                    <Border Height="1" Background="#354B5E79" Margin="0,12,0,12"/>
                    <TextBlock Text="LICHT UND EVENTS" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="LightingModeButton" Content="IMMER NACHT ▾" ToolTip="Helligkeit wählen: immer Nacht, immer Tag oder automatisch" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="LightingModeButton_Click">
                            <Button.ContextMenu><ContextMenu Background="{DynamicResource Surface}" Foreground="{DynamicResource Text}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="4">
                                <ContextMenu.Resources><Style TargetType="MenuItem"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="Transparent"/><Setter Property="FontFamily" Value="pack://application:,,,/assets/fonts/#Barlow"/><Setter Property="FontSize" Value="14"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem"><Border x:Name="MenuRow" Background="{TemplateBinding Background}" Padding="14,9"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="MenuRow" Property="Background" Value="{DynamicResource Line}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ContextMenu.Resources>
                                <MenuItem Header="Immer Nacht" Tag="night" Click="LightingMode_Click"/><MenuItem Header="Immer Tag" Tag="day" Click="LightingMode_Click"/><MenuItem Header="Automatisch · 07–19 Uhr Tag" Tag="auto" Click="LightingMode_Click"/>
                            </ContextMenu></Button.ContextMenu>
                        </Button>
                        <Button x:Name="ThemeInfoButton" Content="Saisonkalender" ToolTip="Saisonkalender und Musikquellen" Style="{StaticResource SecondaryButton}" Click="ThemeInfo_Click"/>
                    </StackPanel>
                    <Button x:Name="EventSettingsButton" Content="Effekte und Event-Geräusche" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch" Margin="0,12,0,0" Click="EventSettings_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border x:Name="PatchNotesHost" Visibility="Collapsed" Background="Transparent" Padding="10,4">
            <Grid x:Name="ScenePanel" Margin="0,0,0,0"><Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/><RowDefinition Height="48"/></Grid.RowDefinitions>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="PatchNotesSubtitle" Visibility="Collapsed" Text="Versionshinweise"/><Button x:Name="RefreshPatchNotesButton" Grid.Column="1" Content="↻  Aktualisieren" ToolTip="Versionshinweise neu laden" Style="{StaticResource SecondaryButton}" Padding="12,6" VerticalAlignment="Top" Click="RefreshPatchNotesButton_Click"/></Grid>
                <ScrollViewer x:Name="PatchNotesScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,8"><TextBlock x:Name="PatchNotesText" Text="Lade Versionshinweise …" Foreground="{DynamicResource Text}" FontFamily="pack://application:,,,/assets/fonts/#Barlow" FontSize="16" LineHeight="26" TextWrapping="Wrap" Padding="0,0,12,4"/></ScrollViewer>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left"><Button x:Name="ReleasePageButton" Content="Release öffnen" Style="{StaticResource SecondaryButton}" MaxWidth="200" Padding="14,4" Margin="0,0,8,0" Click="OpenReleaseButton_Click"/></StackPanel>
            </Grid>
        </Border>
                    </Grid>
                    <Border Grid.Row="2" Margin="24,0,24,16" Padding="14,9" Background="#3A202D43" BorderBrush="#3A65758D" BorderThickness="1" CornerRadius="10">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Text, ElementName=StatusText}" Foreground="{DynamicResource Text}" FontFamily="pack://application:,,,/assets/fonts/#Barlow" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                <ProgressBar Height="4" Margin="0,6,0,0" Minimum="0" Maximum="100" Value="{Binding Value, ElementName=DownloadProgressBar}" IsIndeterminate="{Binding IsIndeterminate, ElementName=DownloadProgressBar}" Visibility="{Binding Visibility, ElementName=ProgressPanel}" Style="{StaticResource ModernProgressBar}"/>
                            </StackPanel>
                            <Button x:Name="MenuCancelButton" Grid.Column="1" Content="Update abbrechen" Style="{StaticResource DangerButton}" Padding="12,6" Margin="14,0,0,0" Visibility="{Binding Visibility, ElementName=CancelButton}" IsEnabled="{Binding IsEnabled, ElementName=CancelButton}" Click="CancelButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            <Grid Grid.Row="2" Background="#CE0B0911">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0"><Ellipse Width="5" Height="5" Fill="{DynamicResource Mint}" Margin="0,0,9,0"/><TextBlock x:Name="TopStatusText" MaxWidth="240" TextTrimming="CharacterEllipsis" Text="Bereit" Foreground="{DynamicResource Muted}" FontFamily="pack://application:,,,/assets/fonts/#Barlow" FontSize="11" VerticalAlignment="Center"/><TextBlock x:Name="ActivityText" Text="Bereit" Visibility="Collapsed" Foreground="{DynamicResource Faint}" FontFamily="pack://application:,,,/assets/fonts/#Barlow" FontSize="10" Margin="11,0,0,0" VerticalAlignment="Center"/></StackPanel>
                <TextBlock x:Name="LauncherStatusText" Grid.Column="1" Text="Launcher wird geprüft …" Foreground="{DynamicResource Faint}" FontFamily="pack://application:,,,/assets/fonts/#Barlow" FontSize="11" Margin="0,0,22,0" VerticalAlignment="Center"/>
            </Grid>
        </Grid>

        <ui:FireworkScene x:Name="FireworksView" IsHitTestVisible="False" ClipToBounds="True"/>
        <ui:GengarScene x:Name="GengarView" IsHitTestVisible="False" ClipToBounds="True"/>
        <ui:BloodSplashScene x:Name="BloodView" IsHitTestVisible="False" ClipToBounds="True"/>
        <ui:MouseTrail x:Name="MouseTrailView" IsHitTestVisible="False"/>
    </Grid>
</Window>
