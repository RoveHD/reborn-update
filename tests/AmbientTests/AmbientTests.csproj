    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/RebornLauncher/Services/HalloweenAmbientSchedule.cs" Link="HalloweenAmbientSchedule.cs" />
    <Compile Include="../../src/RebornLauncher/UI/HalloweenAmbientAudio.cs" Link="HalloweenAmbientAudio.cs" />
    <EmbeddedResource Include="../../src/RebornLauncher/assets/audio/events/ambient-*.wav" LogicalName="PokemonRebornLauncher.events.%(Filename).wav" />
  </ItemGroup>
</Project>
