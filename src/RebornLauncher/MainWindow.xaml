<Window x:Class="PokemonRebornLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:PokemonRebornLauncher.UI"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Pokémon Reborn – Launcher"
        Icon="pack://application:,,,/assets/reborn.ico"
        Width="1180" Height="850" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        ResizeMode="CanResize" Cursor="{DynamicResource ThemeCursor}" Background="#0B090F"
        Loaded="Window_Loaded" KeyDown="Window_KeyDown" Closing="Window_Closing">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <sys:Boolean x:Key="ReduceMotion">False</sys:Boolean>
        <sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarWidthKey}">6</sys:Double>
        <SolidColorBrush x:Key="Ink" Color="#0B090F" />
        <SolidColorBrush x:Key="Surface" Color="#131018" />
        <SolidColorBrush x:Key="Text" Color="#F4F0F0" />
        <SolidColorBrush x:Key="Muted" Color="#B4AEBB" />
        <SolidColorBrush x:Key="Faint" Color="#817986" />
        <SolidColorBrush x:Key="Violet" Color="#B16AE6" />
        <SolidColorBrush x:Key="Mint" Color="#9BE6D2" />
        <SolidColorBrush x:Key="Line" Color="#39313F" />
        <Style x:Key="Eyebrow" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="pack://application:,,,/assets/fonts/#Barlow" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#B4AEBB" />
        </Style>
        <Style x:Key="BodyText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="pack://application:,,,/assets/fonts/#Barlow" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Cursor" Value="{DynamicResource ThemeCursor}" />
            <Setter Property="FontFamily" Value="pack://application:,,,/assets/fonts/#Barlow" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <Border.RenderTransform><TranslateTransform x:Name="ButtonLift" Y="0" /></Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions><Condition Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=Tag}" Value="False"/><Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/></MultiDataTrigger.Conditions>
                                <MultiDataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ButtonLift" Storyboard.TargetProperty="Y" To="-1" Duration="0:0:0.12"/></Storyboard></BeginStoryboard></MultiDataTrigger.EnterActions>
                                <MultiDataTrigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ButtonLift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.12"/></Storyboard></BeginStoryboard></MultiDataTrigger.ExitActions>
                            </MultiDataTrigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.72"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.4"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{DynamicResource Mint}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Foreground" Value="#FFB8C0" />
            <Setter Property="BorderBrush" Value="#854357" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#100B15" />
            <Setter Property="Background" Value="{DynamicResource Violet}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Mint}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="24,0" />
            <Setter Property="Height" Value="66" />
            <Setter Property="MinWidth" Value="228" />
            <Setter Property="Cursor" Value="{DynamicResource ThemeCursor}" />
            <Setter Property="FontFamily" Value="pack://application:,,,/assets/fonts/#Barlow Condensed" />
            <Setter Property="FontSize" Value="23" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CtaSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <Border.RenderTransform><TranslateTransform x:Name="CtaLift" Y="0" /></Border.RenderTransform>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/><TextBlock Grid.Column="1" Text="↗" FontFamily="Segoe UI Symbol" FontSize="20" FontWeight="Normal" VerticalAlignment="Center" Margin="18,0,0,0"/></Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions><Condition Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=Tag}" Value="False"/><Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/></MultiDataTrigger.Conditions>
                                <MultiDataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="CtaLift" Storyboard.TargetProperty="Y" To="-2" Duration="0:0:0.16"/></Storyboard></BeginStoryboard></MultiDataTrigger.EnterActions>
                                <MultiDataTrigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="CtaLift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.16"/></Storyboard></BeginStoryboard></MultiDataTrigger.ExitActions>
                            </MultiDataTrigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="CtaSurface" Property="Opacity" Value="0.78"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="CtaSurface" Property="Opacity" Value="0.4"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CtaSurface" Property="BorderBrush" Value="{DynamicResource Mint}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WindowControlButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="MinWidth" Value="42"/><Setter Property="MinHeight" Value="32"/><Setter Property="Foreground" Value="#D4CCD8"/>
        </Style>
        <Style x:Key="VersionSegment" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0,0,0,2"/><Setter Property="BorderBrush" Value="#39313F"/><Setter Property="Padding" Value="0,8"/><Setter Property="MinHeight" Value="34"/><Setter Property="Foreground" Value="#A79EAA"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="{DynamicResource Mint}"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="ToggleCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="FontFamily" Value="pack://application:,,,/assets/fonts/#Barlow"/><Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="{DynamicResource ThemeCursor}"/><Setter Property="Focusable" Value="True"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid MinHeight="30"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/><Border x:Name="SwitchTrack" Grid.Column="1" Width="36" Height="20" Background="#332B39" BorderBrush="#56475F" BorderThickness="1" CornerRadius="10" HorizontalAlignment="Right" VerticalAlignment="Center"><Ellipse x:Name="SwitchThumb" Width="12" Height="12" Fill="#B9AFBF" HorizontalAlignment="Left" Margin="3,0,0,0"><Ellipse.RenderTransform><TranslateTransform x:Name="SwitchPosition" X="0" /></Ellipse.RenderTransform></Ellipse></Border><Border x:Name="FocusMark" Grid.ColumnSpan="2" BorderBrush="Transparent" BorderThickness="1" CornerRadius="1" IsHitTestVisible="False"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="SwitchTrack" Property="Background" Value="{DynamicResource Surface}"/><Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{DynamicResource Violet}"/><Setter TargetName="SwitchThumb" Property="Fill" Value="{DynamicResource Mint}"/><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="SwitchPosition" Storyboard.TargetProperty="X" To="16" Duration="0:0:0.16"/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="SwitchPosition" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16"/></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusMark" Property="BorderBrush" Value="{DynamicResource Mint}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ModernProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="5"/><Setter Property="Background" Value="#302738"/><Setter Property="Foreground" Value="{DynamicResource Mint}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar"><Grid ClipToBounds="True"><Border Background="{TemplateBinding Background}"/><Border x:Name="PART_Track"/><Decorator x:Name="PART_Indicator" HorizontalAlignment="Left"><Border Background="{TemplateBinding Foreground}"/></Decorator></Grid></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="5"/><Setter Property="Opacity" Value="0.5"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
                <Grid Background="Transparent"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
                    <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False" Opacity="0"/></Track.DecreaseRepeatButton>
                    <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#42314F" CornerRadius="3" Margin="1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                    <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False" Opacity="0"/></Track.IncreaseRepeatButton>
                </Track></Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="Slider">
          <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Border x:Name="SliderFocus" BorderThickness="1" BorderBrush="Transparent" Padding="3">
            <Grid><Border Background="#4A3C55" Height="3" VerticalAlignment="Center" CornerRadius="2"/>
              <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}">
                <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False" Opacity="0"/></Track.DecreaseRepeatButton>
                <Track.Thumb><Thumb Width="12" Height="12"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="{DynamicResource Mint}"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False" Opacity="0"/></Track.IncreaseRepeatButton>
              </Track></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SliderFocus" Property="BorderBrush" Value="{DynamicResource Mint}"/></Trigger></ControlTemplate.Triggers>
          </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Background="{DynamicResource Ink}" ClipToBounds="True">
        <Image x:Name="SceneArtwork" Stretch="UniformToFill" Opacity="0.16" IsHitTestVisible="False" />
        <Grid IsHitTestVisible="False"><Grid.RenderTransform><TranslateTransform x:Name="SceneTranslate"/></Grid.RenderTransform>
            <Rectangle Fill="#A3090710" />
            <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#F70B0910" Offset="0"/><GradientStop Color="#A80B0910" Offset="0.56"/><GradientStop Color="#F80B0910" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
            <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#E80B0910" Offset="0"/><GradientStop Color="#000B0910" Offset="0.2"/><GradientStop Color="#000B0910" Offset="0.78"/><GradientStop Color="#F00B0910" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
        </Grid>
        <Border x:Name="AccentGlow" Width="520" Height="310" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="220,105,0,0" Opacity="0.11" IsHitTestVisible="False">
            <Border.Background><RadialGradientBrush><GradientStop Color="#A95BCD" Offset="0"/><GradientStop Color="#585BCD" Offset="0.48"/><GradientStop Color="#00585BCD" Offset="1"/></RadialGradientBrush></Border.Background>
        </Border>
        <Viewbox x:Name="AmbientRing" Width="780" Height="780" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="80,-145,0,0" Opacity="0.23" IsHitTestVisible="False">
          <Grid Width="700" Height="700" RenderTransformOrigin="0.5,0.5"><Grid.RenderTransform><RotateTransform x:Name="RingRotation"/></Grid.RenderTransform>
            <Ellipse Stroke="{DynamicResource Violet}" StrokeThickness="1" Margin="25"/><Ellipse Stroke="{DynamicResource Line}" StrokeThickness="28" Margin="40"/>
            <Ellipse Stroke="{DynamicResource Violet}" StrokeThickness="4" StrokeDashArray="0.5 16" Margin="62"/>
            <Ellipse Stroke="{DynamicResource Line}" StrokeThickness="1" Margin="94"/><Line X1="350" Y1="0" X2="350" Y2="700" Stroke="{DynamicResource Line}"/><Line X1="0" Y1="350" X2="700" Y2="350" Stroke="{DynamicResource Line}"/>
          </Grid>
        </Viewbox>
        <ui:SeasonalScene x:Name="SeasonalBackdrop" IsHitTestVisible="False"/>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="48"/></Grid.RowDefinitions>
            <!-- Custom title bar -->
            <Grid Grid.Row="0" Background="#D10D0A13">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0" IsHitTestVisible="False">
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource Mint}" Margin="0,0,10,0"/>
                    <TextBlock Text="POKÉMON REBORN" Foreground="#E7E0E9" FontFamily="pack://application:,,,/assets/fonts/#Barlow" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="  /  LAUNCHER" Foreground="#827A88" FontFamily="pack://application:,,,/assets/fonts/#Barlow" FontSize="10" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="ThemeInfoButton" Content="SAISON · AUTOMATISCH" ToolTip="Saisonkalender und Musikquellen" FontSize="10" Padding="12,0" Style="{StaticResource WindowControlButton}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="ThemeInfo_Click"/>
                    <Button x:Name="FullscreenButton" Content="□" ToolTip="Fenster maximieren oder wiederherstellen" Width="42" Style="{StaticResource WindowControlButton}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="FullscreenButton_Click" />
                    <Button Content="—" ToolTip="Minimieren" Style="{StaticResource WindowControlButton}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="MinimizeButton_Click" />
                    <Button Content="×" ToolTip="Schließen" Style="{StaticResource WindowControlButton}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="CloseWindowButton_Click" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" MaxWidth="1440" HorizontalAlignment="Stretch" Margin="38,22,38,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="0"/><ColumnDefinition Width="1"/><ColumnDefinition Width="310" MinWidth="270"/></Grid.ColumnDefinitions>
                <Grid x:Name="HeroPanel" Grid.Column="0" Margin="0,0,42,0">
                    <Grid.RenderTransform><TranslateTransform x:Name="HeroTranslate"/></Grid.RenderTransform>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <ScrollViewer x:Name="HeroScroller" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,4,0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="SeasonTitleText" Text="ZURÜCK IN" Style="{StaticResource Eyebrow}" Foreground="{DynamicResource Mint}" />
                                    <Grid Height="135" MaxWidth="360" Margin="-8,6,0,0" HorizontalAlignment="Left">
                                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <StackPanel x:Name="LogoFallback">
                                                <TextBlock Text="POKÉMON" Foreground="#F5EFF5" FontFamily="pack://application:,,,/assets/fonts/#Barlow Condensed" FontSize="77" FontWeight="Black" LineHeight="76" />
                                                <TextBlock Text="REBORN" Foreground="#C58BE8" FontFamily="pack://application:,,,/assets/fonts/#Barlow Condensed" FontSize="89" FontWeight="Black" Margin="0,-34,0,0" />
                                            </StackPanel>
                                        </Viewbox>
                                        <Image x:Name="LogoArtwork" Stretch="Uniform" Visibility="Collapsed" />
                                    </Grid>
                                    <TextBlock x:Name="SeasonSubtitleText" TextWrapping="Wrap" Text="Deine Geschichte geht weiter." Style="{StaticResource BodyText}" FontSize="15" Margin="0,8,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,12,0,0">
                                    <Image x:Name="PokemonArtwork" Source="pack://application:,,,/assets/artwork/umbreon.png" Width="200" Height="200" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"><Image.RenderTransform><TranslateTransform x:Name="ArtworkFloat"/></Image.RenderTransform></Image>
                                    <TextBlock x:Name="PokemonNameText" Text="NACHTARA" Foreground="#D8C8E2" FontFamily="pack://application:,,,/assets/fonts/#Barlow" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,5"/>
                                    <Button x:Name="ChangeArtworkButton" Content="Motiv wechseln" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Center" MinHeight="28" Padding="9,4" FontSize="10" Click="ChangeArtwork_Click"/>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,12,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center"><TextBlock Text="SPIELVERSION" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="LocalVersionText" Text="–" Foreground="{DynamicResource Text}" FontFamily="pack://application:,,,/assets/fonts/#Barlow Condensed" FontSize="24" FontWeight="Bold" Margin="0,2,0,0"/></StackPanel>
                                <Border Grid.Column="1" Height="1" Background="#493E50" Margin="20,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"><TextBlock Text="LETZTER PATCH" Style="{StaticResource Eyebrow}" TextAlignment="Right"/><TextBlock x:Name="RemoteVersionText" Text="Prüfe …" Foreground="{DynamicResource Mint}" FontFamily="pack://application:,,,/assets/fonts/#Barlow Condensed" FontSize="24" FontWeight="Bold" Margin="0,2,0,0" HorizontalAlignment="Right"/></StackPanel>
                            </Grid>

                            <StackPanel Grid.Row="2" Margin="0,0,0,15">
                                <Border x:Name="UpdateBadgeBorder" Background="#1D1A22" BorderBrush="#695282" BorderThickness="0,0,0,1" Padding="0,6" Margin="0,0,0,9"><TextBlock x:Name="UpdateBadgeText" Text="Status wird geprüft" Foreground="#E5C5F4" FontFamily="pack://application:,,,/assets/fonts/#Barlow" FontWeight="SemiBold" FontSize="12"/></Border>
                                <TextBlock x:Name="StatusText" Text="Der Launcher ist bereit." Style="{StaticResource BodyText}" MinHeight="20" TextWrapping="Wrap" />
                                <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,12,0,0"><ProgressBar x:Name="DownloadProgressBar" Style="{StaticResource ModernProgressBar}" Minimum="0" Maximum="100" Value="0"/><Grid Margin="0,7,0,0"><TextBlock x:Name="ProgressText" Text="Warte …" Style="{StaticResource BodyText}" FontSize="11"/><TextBlock x:Name="SpeedText" Foreground="{DynamicResource Mint}" FontFamily="pack://application:,,,/assets/fonts/#Barlow" FontSize="11" HorizontalAlignment="Right"/></Grid></StackPanel>
                            </StackPanel>



                        </Grid>
                    </ScrollViewer>
                            <StackPanel Grid.Row="1" Margin="0,14,0,0">
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="VERSION WÄHLEN" Style="{StaticResource Eyebrow}" Margin="0,0,0,6"/>
                                <Grid HorizontalAlignment="Left" MinWidth="300"><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="145"/></Grid.ColumnDefinitions>
                                    <Button x:Name="LatestVersionButton" Content="Aktuell" Style="{StaticResource VersionSegment}" Click="VersionButton_Click"/>
                                    <Button x:Name="PreviousVersionButton" Grid.Column="1" Content="Vorherige" Style="{StaticResource VersionSegment}" Click="VersionButton_Click"/>
                                </Grid>
                                <TextBlock x:Name="VersionSelectionHint" Text="Eine zweite Version ist nach dem nächsten Spielupdate verfügbar." Style="{StaticResource BodyText}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                                <Button x:Name="StartGameButton" Content="SPIEL STARTEN" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,0,0,10" Click="StartGameButton_Click"/>
                                <WrapPanel Margin="0,0,0,6"><Button x:Name="CheckUpdatesButton" Content="Updates suchen" Style="{StaticResource SecondaryButton}" Margin="0,0,9,8" Click="CheckUpdatesButton_Click"/><Button x:Name="RepairButton" Content="Dateien reparieren" Style="{StaticResource SecondaryButton}" Margin="0,0,9,8" Click="RepairButton_Click"/><Button x:Name="CancelButton" Content="Abbrechen" Visibility="Collapsed" Style="{StaticResource DangerButton}" Margin="0,0,9,8" Click="CancelButton_Click"/><Button x:Name="ChooseFolderButton" Content="Spielordner auswählen  →" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,0,0,8" Click="ChooseFolderButton_Click"/></WrapPanel>

                                <StackPanel>
                                    <CheckBox x:Name="AutoUpdateCheckBox" MaxWidth="460" HorizontalAlignment="Left" Width="460" Content="Vor dem Start automatisch aktualisieren" Style="{StaticResource ToggleCheckBox}" Margin="0,0,0,2" Checked="AutoUpdateCheckBox_Changed" Unchecked="AutoUpdateCheckBox_Changed"/>
                                    <CheckBox x:Name="CloseAfterStartCheckBox" MaxWidth="460" HorizontalAlignment="Left" Width="460" Content="Launcher nach Spielstart schließen" Style="{StaticResource ToggleCheckBox}" FontSize="11" Checked="CloseAfterStartCheckBox_Changed" Unchecked="CloseAfterStartCheckBox_Changed"/>
                                </StackPanel>
                            </StackPanel>

                </Grid>

                <Border Grid.Column="1" Background="#44394C" Margin="0,8,0,8"/>

                <Grid x:Name="ScenePanel" Grid.Column="2" Margin="28,8,0,0">

                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,19">
                        <TextBlock Text="NEUIGKEITEN" Style="{StaticResource Eyebrow}" Foreground="{DynamicResource Violet}"/>
                        <TextBlock Text="Was sich verändert" Foreground="{DynamicResource Text}" FontFamily="pack://application:,,,/assets/fonts/#Barlow Condensed" FontSize="29" FontWeight="Bold" Margin="0,3,0,0"/>
                        <TextBlock x:Name="PatchNotesSubtitle" Text="Versionshinweise" Style="{StaticResource BodyText}" FontSize="11" Margin="0,3,0,0"/>
                        <Button x:Name="RefreshPatchNotesButton" Content="↻  Neu laden" Style="{StaticResource SecondaryButton}" MinWidth="0" HorizontalAlignment="Left" Margin="0,11,0,0" Padding="9,5" Click="RefreshPatchNotesButton_Click"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,1,18">
                        <TextBlock x:Name="PatchNotesText" Text="Lade Versionshinweise …" Foreground="#D7D0DA" FontFamily="pack://application:,,,/assets/fonts/#Barlow" FontSize="13" LineHeight="21" TextWrapping="Wrap" Padding="0,3,9,8"/>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Margin="0,8,0,0">
                        <Border Height="1" Background="#493E50" Margin="0,0,0,12"/>
                        <Button Content="Release-Seite öffnen  ↗" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,0,0,8" Click="OpenReleaseButton_Click"/>
                        <Button Content="Spielordner öffnen  ↗" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="OpenFolderButton_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid Grid.Row="2" Margin="38,0,38,0" Background="#D10B0910">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="5" Height="5" Fill="{DynamicResource Mint}" Margin="0,0,9,0"/><TextBlock x:Name="TopStatusText" MaxWidth="150" TextTrimming="CharacterEllipsis" Text="Bereit" Foreground="{DynamicResource Muted}" FontFamily="pack://application:,,,/assets/fonts/#Barlow" FontSize="10" VerticalAlignment="Center"/><TextBlock x:Name="ActivityText" Text="Bereit" Visibility="Collapsed" Foreground="{DynamicResource Faint}" FontFamily="pack://application:,,,/assets/fonts/#Barlow" FontSize="10" Margin="11,0,0,0" VerticalAlignment="Center"/></StackPanel>
                <TextBlock x:Name="LauncherStatusText" Grid.Column="1" Text="Launcher wird geprüft …" Foreground="{DynamicResource Faint}" FontFamily="pack://application:,,,/assets/fonts/#Barlow" FontSize="10" Margin="0,0,22,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="MAUSSPUR" Style="{StaticResource Eyebrow}" FontSize="9" VerticalAlignment="Center" Margin="0,0,7,0"/><CheckBox x:Name="MouseTrailCheckBox" ToolTip="Leuchtspur hinter dem Mauszeiger" Style="{StaticResource ToggleCheckBox}" Width="44" Margin="0,0,14,0" Checked="MouseTrail_Changed" Unchecked="MouseTrail_Changed"/>
                    <TextBlock Text="MUSIK" Style="{StaticResource Eyebrow}" FontSize="9" VerticalAlignment="Center" Margin="0,0,9,0"/><CheckBox x:Name="MusicCheckBox" ToolTip="Hintergrundmusik an oder aus" Style="{StaticResource ToggleCheckBox}" Width="44" Margin="0,0,10,0" Checked="MusicToggle_Changed" Unchecked="MusicToggle_Changed"/>
                    <TextBlock x:Name="MusicStatusText" Text="AN" Width="48" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Foreground="{DynamicResource Mint}" FontFamily="pack://application:,,,/assets/fonts/#Barlow" FontSize="9" VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False"/>
                    <TextBlock Text="♪" Foreground="{DynamicResource Faint}" FontFamily="Segoe UI Symbol" FontSize="12" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <Slider x:Name="MusicVolumeSlider" ToolTip="Musiklautstärke" Width="75" Height="24" Minimum="0" Maximum="1" Value="0.22" SmallChange="0.02" LargeChange="0.1" IsMoveToPointEnabled="True" Focusable="True" ValueChanged="MusicVolume_Changed"/>
                    <TextBlock Text="RUHIGE EFFEKTE" Style="{StaticResource Eyebrow}" FontSize="9" VerticalAlignment="Center" Margin="0,0,9,0"/><CheckBox x:Name="ReduceMotionCheckBox" ToolTip="Animationen reduzieren" Style="{StaticResource ToggleCheckBox}" Width="44" Margin="0" Checked="ReduceMotion_Changed" Unchecked="ReduceMotion_Changed"/>
                </StackPanel>
            </Grid>
        </Grid>
        <ui:MouseTrail x:Name="MouseTrailView" IsHitTestVisible="False"/>
    </Grid>
</Window>
