<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PokemonRebornLauncher</RootNamespace>
    <AssemblyName>launcher</AssemblyName>
    <Product>Pokemon Reborn Launcher</Product>
    <Authors>Elias</Authors>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets/reborn.ico</ApplicationIcon>
    <Version>7.4.0</Version>
    <AssemblyVersion>7.4.0.0</AssemblyVersion>
    <FileVersion>7.4.0.0</FileVersion>
    <Description>Reborn Launcher mit automatischer Selbstaktualisierung</Description>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <None Update="settings.json" CopyToOutputDirectory="Never" />
    <None Include="../../docs/DESIGN-QUELLEN.md" Link="credits/DESIGN-QUELLEN.md" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../docs/SEASONAL-MUSIC-SOURCES.md" Link="credits/SEASONAL-MUSIC-SOURCES.md" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../docs/MUSIC-CREDITS.txt" Link="credits/MUSIC-CREDITS.txt" CopyToPublishDirectory="PreserveNewest" />
    <None Update="assets/fonts/OFL.txt" Link="credits/Barlow-OFL.txt" CopyToPublishDirectory="PreserveNewest" />
    <Resource Include="assets/reborn.ico" />
    <Resource Include="assets/fonts/*.ttf" />
    <EmbeddedResource Include="assets/fonts/OFL.txt" LogicalName="PokemonRebornLauncher.Barlow-OFL.txt" />
    <EmbeddedResource Include="../../docs/MUSIC-CREDITS.txt" LogicalName="PokemonRebornLauncher.MUSIC-CREDITS.txt" />
    <Resource Include="assets/artwork/*.png" />
    <Resource Include="assets/scenery/anime/*-foreground.png" />
    <Resource Include="assets/scenery/inhabited/*.png" />
    <Resource Include="assets/scenery/parallax/*.png" />
    <Resource Include="assets/scenery/props/halloween-*.png" />
    <Resource Include="assets/scenery/props/*-props.png" />
    <EmbeddedResource Include="assets/audio/events/*.wav" LogicalName="PokemonRebornLauncher.events.%(Filename).wav"/>
    <None Include="../../docs/EVENT-SOUND-CREDITS.md" Link="credits/EVENT-SOUND-CREDITS.md" CopyToPublishDirectory="PreserveNewest"/>
    <None Include="../../docs/HALLOWEEN-AMBIENT-AUDIO.md" Link="credits/HALLOWEEN-AMBIENT-AUDIO.md" CopyToPublishDirectory="PreserveNewest"/>
    <None Include="../../docs/HALLOWEEN-BAT-FLIGHT.md" Link="credits/HALLOWEEN-BAT-FLIGHT.md" CopyToPublishDirectory="PreserveNewest"/>
    <None Include="../../docs/HALLOWEEN-PARALLAX.md" Link="credits/HALLOWEEN-PARALLAX.md" CopyToPublishDirectory="PreserveNewest"/>
    <None Include="../../docs/HALLOWEEN-PROPS-GROUNDING.md" Link="credits/HALLOWEEN-PROPS-GROUNDING.md" CopyToPublishDirectory="PreserveNewest"/>
    <EmbeddedResource Include="assets/audio/music-*.mp3" LogicalName="PokemonRebornLauncher.%(Filename)%(Extension)" />
    <EmbeddedResource Include="assets/audio/reborn-theme.mp3" LogicalName="PokemonRebornLauncher.reborn-theme.mp3" />
    <None Include="background.png" Condition="Exists('background.png')" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="logo.png" Condition="Exists('logo.png')" LogicalName="PokemonRebornLauncher.logo.png" />
    <None Include="icon.ico" Condition="Exists('icon.ico')" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
